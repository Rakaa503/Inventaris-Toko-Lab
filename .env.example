APP_NAME="K3 Inventaris"
APP_ENV=development
APP_DEBUG=false
APP_URL=http://127.0.0.1:8081
APP_TIMEZONE=Asia/Jakarta
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=inventaris_k3
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

SESSION_NAME=k3_inventory_session
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=Lax

RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=900
RATE_LIMIT_API_MAX=60
RATE_LIMIT_API_WINDOW=60

PASSWORD_ALGORITHM=default
LOG_LEVEL=warning